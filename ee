// Landscape Painter - Mountains, sunrise, trees
class _LandscapePainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    // Sun
    final sunPaint = Paint()..color = Colors.yellow.withValues(alpha: 0.8);
    canvas.drawCircle(Offset(size.width - 40, 20), 12, sunPaint);

    // Mountains
    final mountainPaint = Paint()..color = Colors.white.withValues(alpha: 0.3);
    final mountainPath = Path()
      ..moveTo(0, size.height)
      ..lineTo(size.width * 0.3, size.height * 0.4)
      ..lineTo(size.width * 0.5, size.height)
      ..lineTo(size.width * 0.7, size.height * 0.3)
      ..lineTo(size.width, size.height)
      ..close();
    canvas.drawPath(mountainPath, mountainPaint);

    // Trees
    final treePaint = Paint()..color = Colors.green.withValues(alpha: 0.5);
    canvas.drawCircle(Offset(size.width * 0.4, size.height - 15), 8, treePaint);
    canvas.drawCircle(Offset(size.width * 0.6, size.height - 12), 10, treePaint);
    canvas.drawCircle(Offset(size.width * 0.8, size.height - 10), 7, treePaint);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}
